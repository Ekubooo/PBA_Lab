// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CollisionDetect

struct PointData
{
    float3 pPos;
    int isCollision;   // 1 Byte
};

struct GlobalData
{
    float3 avgPoint;
	int cCounter ;
};

float3 PanelPos;
float3 PanelNormal;
float3 objVelocity;
float3 objW;

float3x3 worldTrans;
float3x3 qMatrix;
RWStructuredBuffer<PointData> cPoint;
RWStructuredBuffer<GlobalData> gData;

[numthreads(1,1,1)]
void CollisionDetect (uint3 id : SV_DispatchThreadID)
{
    PointData thePoint  = cPoint[id.x];
    GlobalData theGd    = gData[id.x];
    float3 vertPos      = thePoint.pPos;
    float3 xi           = mul(worldTrans, vertPos);
    float sdf           = dot(xi - PanelPos,PanelNormal);

    if (sdf < 0.0f)
    {
        float3 Rri = mul(qMatrix, vertPos);
        float3 vi = objVelocity + cross(objW, Rri);
        float viDotN = dot(vi,PanelNormal);
        if(viDotN < 0.0f)
        {
            thePoint.isCollision = 1;
            theGd.avgPoint += thePoint.pPos;
            theGd.cCounter += 1; 
        }
    }
    cPoint[id.x] = thePoint;
}