#pragma kernel CollisionDetect

struct PointData
{
    float3 pPos;
	int isCollision;
};
struct GlobalData
{
    float3 avgPoint;
	int cCounter;
};

uint vertCount;
float4 PanelPos;
float4 PanelNormal;
float4 objVelocity;
float4 objW;
float4x4 qMatrix;

RWStructuredBuffer<float3> cPoint;
RWStructuredBuffer<PointData> pointSet;
RWStructuredBuffer<GlobalData> gData;

[numthreads(8,8,8)]
void CollisionDetect(uint3 id : SV_DispatchThreadID)
{
    if (id.x > vertCount) return;
    float3 thePoint1  = cPoint[id.x];             // vertices[]
    float4 thePoint2  = float4(cPoint[id.x], 1.0f);   // vertices[]
    PointData xi     = pointSet[id.x];
    // float3 xi     = pointSet[id.x].pPos; // xi transformPoint
    GlobalData theGd = gData[id.x];
    float sdf        = dot(xi.pPos - PanelPos.xyz, PanelNormal.xyz);
    if (sdf <= 0.0f)
    {   
        float4 Rri_T   = mul(qMatrix, thePoint2);
        float3 Rri = Rri_T.xyz;
        float3 vi    = objVelocity.xyz + cross(Rri, objW.xyz);
        if(dot(vi,PanelNormal.xyz) < 0.0f)
        {
            // method 1
            xi.isCollision = 1;
            // method 2
            GroupMemoryBarrierWithGroupSync();
            // RW lock not include
            theGd.avgPoint += thePoint2.xyz;
            theGd.cCounter += 1; 
        }
    }
    cPoint[id.x]    = thePoint2.xyz;
    gData[id.x]     = theGd;
    pointSet[id.x]  = xi;
}